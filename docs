ConsultaService.java
package service;
import model.*;
import repository.Repositorio;
public class ConsultaService {
private Repositorio<Consulta> repositorio =
new Repositorio<>();
public void cadastrar(Consulta c){
repositorio.adicionar(c);
}
public void remover(Consulta c){
repositorio.remover(c);
}
public java.util.List<Consulta> listar(){
return repositorio.listar();
}
}
Interfaces Funcionais
Predicate<Consulta> filtroEspecialidade =
c -> c.getEspecialidade() == Especialidade.CARDIOLOGIA;
Predicate<Consulta> filtroValor =
c -> c.getValorConsulta() > 200;
Comparator<Consulta> porNome =
Comparator.comparing(Consulta::getNomePaciente);
Comparator<Consulta> porData =
Comparator.comparing(Consulta::getDataConsulta);
Function<Consulta,String> formatador =
c -> c.getNomePaciente() + " - " + c.getEspecialidade();
Consumer<Consulta> exibir =
c -> System.out.println(c);
