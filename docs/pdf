Classe Main.java
package pm_prova2;
import java.util.ArrayList;
public class PM_Prova2 {
public static void main(String[] args) {
ArrayList<Atividade> atividades = new ArrayList<>();
ArrayList<Plano> planos = new ArrayList<>();
Musculacao musculacao = new Musculacao(
"Musculação", 60, 30,
120.0,
StatusAtividade.ATIVA,
20
);
Natacao natacao = new Natacao(
"Natação", 50, 15,
180.0,
StatusAtividade.LOTADA,
2.0,
true
);
Spinning spinning = new Spinning(
"Spinning", 45, 20,
150.0,
StatusAtividade.INATIVA,
15
);
atividades.add(musculacao);
atividades.add(natacao);
atividades.add(spinning);
PlanoBasico basico = new PlanoBasico(
"Plano Básico",
99.90,
1,
StatusPlano.ATIVO
);
PlanoPremium premium = new PlanoPremium(
"Plano Premium",
199.90,
10,
StatusPlano.ATIVO
);
planos.add(basico);
planos.add(premium);
for(Atividade a : atividades) {
a.exibirDetalhes();
}
for(Plano p : planos) {
p.exibirDetalhes();
}
atividades.removeIf