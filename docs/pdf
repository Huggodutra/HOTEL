Sistema desenvolvido utilizando os principais conceitos de Programação Orientada a Objetos: Herança, Polimorfismo,
Encapsulamento, Interfaces, Classes Abstratas, Enum e Collections.
Interface Certificavel.java
package pm_prova2;
public interface Certificavel {
void emitirCertificado(String nomeParticipante);
}
Interface ControladorPresenca.java
package pm_prova2;
public interface ControladorPresenca {
void registrarPresenca(String nomeParticipante);
}
Enum StatusAtividade.java
package pm_prova2;
public enum StatusAtividade {
ATIVA,
LOTADA,
INATIVA
}
Enum StatusPlano.java
package pm_prova2;
public enum StatusPlano {
ATIVO,
SUSPENSO,
CANCELADO
}
Classe Musculacao.java
package pm_prova2;
public class Musculacao extends Atividade {
private int quantidadeAparelhos;
public Musculacao(String nome,
int duracaoAula,
int quantidadeMaximaParticipantes,
double valorMensal,
StatusAtividade status,
int quantidadeAparelhos) {
super(nome, duracaoAula,
quantidadeMaximaParticipantes,
valorMensal, status);
this.quantidadeAparelhos = quantidadeAparelhos;
}
@Override
public void exibirDetalhes() {
System.out.println("Musculação: " + getNome());
}
@Override
public boolean atividadeColetiva() {
return false;
}
}
Classe Natacao.java
package pm_prova2;
public class Natacao extends Atividade
implements Certificavel, ControladorPresenca {
private double profundidadePiscina;
private boolean ofereceCertificado;
public Natacao(String nome,
int duracaoAula,
int quantidadeMaximaParticipantes,
double valorMensal,
StatusAtividade status,
double profundidadePiscina,
boolean ofereceCertificado) {
super(nome, duracaoAula,
quantidadeMaximaParticipantes,
valorMensal, status);
this.profundidadePiscina = profundidadePiscina;
this.ofereceCertificado = ofereceCertificado;
@Override
public void emitirCertificado(String nomeParticipante) {
System.out.println("Certificado emitido para "
+ nomeParticipante);
}
}
@Override
public void registrarPresenca(String nomeParticipante) {
System.out.println("Presença registrada.");
}
@Override
public void exibirDetalhes() {
System.out.println("Natação: " + getNome());
}
@Override
public boolean atividadeColetiva() {
return true;
}
}
